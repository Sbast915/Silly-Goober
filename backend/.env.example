# Copy this file to .env for local dev, or set these as environment
# variables in your hosting provider's dashboard. Never commit the real
# values.

# Generate hashes locally with:
#   node -e "console.log(require('bcryptjs').hashSync('your passphrase here', 10))"

# Hash of the REAL passphrase -> unlocks the actual call UI
REAL_PASS_HASH=

# Hash of the DECOY passphrase -> unlocks the fake, harmless call UI
DECOY_PASS_HASH=

# Port the server listens on (Render sets this automatically, but a
# default is used if unset)
PORT=3000

# --- Optional TURN configuration ---
# If both are set, the server will fetch fresh short-lived TURN
# credentials from Metered's REST endpoint at call time. If not set,
# a hardcoded fallback (Google STUN + Open Relay TURN) is used.
# Sign up free at https://www.metered.ca/tools/openrelay/ to get:
#   METERED_APP_NAME  = your subdomain (e.g. "sillygoober" if the
#                        dashboard URL is sillygoober.metered.live)
#   METERED_API_KEY   = the API key from the dashboard
METERED_APP_NAME=
METERED_API_KEY=
