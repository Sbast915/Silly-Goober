# Copy this file to .env for local dev, or set these as environment
# variables in your hosting provider's dashboard. Never commit the real
# values.

# Generate hashes locally with:
#   node -e "console.log(require('bcryptjs').hashSync('your passphrase here', 10))"

# Hash of the REAL passphrase -> unlocks the actual call UI
REAL_PASS_HASH=

# Hash of the DECOY passphrase -> unlocks the fake, harmless call UI
DECOY_PASS_HASH=

# Port the server listens on (Render sets this automatically, but a
# default is used if unset)
PORT=3000

# --- TURN (self-hosted coturn) ---
# TURN_SECRET must match `static-auth-secret` in /etc/turnserver.conf on the
# TURN host. The backend derives short-lived HMAC-SHA1 credentials from it per
# request (coturn "TURN REST API" scheme), so the secret itself never reaches
# the browser. Without it, only public STUN is offered and calls across strict
# NATs will fail.
TURN_SECRET=

# Host/ports of the coturn box. Defaults match the provisioned server.
TURN_HOST=141.148.243.201
TURN_PORT=3478
TURN_REALM=silly-goober.turn

# TTL (seconds) for issued TURN credentials.
TURN_TTL=3600

# Set TURN_TLS=1 ONLY after installing a cert+key on coturn (cert=/pkey= in
# turnserver.conf). coturn refuses to open its TLS listener without them, so
# enabling this prematurely advertises a turns:// endpoint that always fails.
TURN_TLS_PORT=5349
TURN_TLS=0
