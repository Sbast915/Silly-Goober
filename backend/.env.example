# Copy this file to .env for local dev, or set these as environment
# variables in your hosting provider's dashboard. Never commit the real
# values.

# Generate hashes locally with:
#   node -e "console.log(require('bcryptjs').hashSync('your passphrase here', 10))"

# Hash of the REAL passphrase -> unlocks the actual call UI
REAL_PASS_HASH=

# Hash of the DECOY passphrase -> unlocks the fake, harmless call UI
DECOY_PASS_HASH=

# Port the server listens on (Render sets this automatically, but a
# default is used if unset)
PORT=3000

# --- Optional TURN configuration (Metered) ---
# The server can fetch fresh TURN credentials from Metered. Set
# METERED_APP_NAME plus EXACTLY ONE of the two key vars below. If
# neither key is set, a hardcoded fallback (Google STUN + Open Relay
# TURN) is used, which is often unreliable across strict NATs.
#
# METERED_APP_NAME = your app's subdomain, e.g. "sillygoober" if the
#                    dashboard shows the URL "sillygoober.metered.live".
METERED_APP_NAME=

# Pick ONE of the following two, based on which key you have. Metered's
# dashboard confusingly shows multiple key types:
#
# 1) METERED_SECRET_KEY -- RECOMMENDED. This is the "Secret Key" from
#    Dashboard -> Developers. It is the prominent key most people see
#    first. The backend uses it to auto-list-or-create a credential and
#    then fetch fresh ICE servers on each call.
METERED_SECRET_KEY=

# 2) METERED_API_KEY -- the per-credential "API Key" you get by clicking
#    "Show API Key" next to a specific TURN credential you have already
#    created via "Add Credential" in the dashboard. This is NOT the
#    Developers-page Secret Key; using the Secret Key here will get you
#    401 "Invalid API Key". Leave blank if using METERED_SECRET_KEY.
METERED_API_KEY=
